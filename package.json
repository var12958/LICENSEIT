{
    "name": "LICENSEIT",
    "version": "0.1.0",
    "private": true,
    "description": "LICENSEIT: licensed training data on Shelby with per-asset consent receipts",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "upload:file": "tsx src/upload/cli.ts file",
        "upload:dataset": "tsx src/upload/cli.ts dataset",
        "read:blob": "tsx src/read/cli.ts",
        "access:request": "tsx src/access/cli.ts",
        "audit:run": "tsx src/audit/cli.ts"
    },
    "dependencies": {
        "@aptos-labs/ts-sdk": "^6.3.1",
        "@shelby-protocol/sdk": "^0.9.2"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
